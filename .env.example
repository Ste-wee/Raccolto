# Copia questo file in .env e compila i valori reali. Non committare mai .env!

# Firebase (console.firebase.google.com > impostazioni progetto)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API key — per ORA usata lato client per sviluppo rapido in locale.
# Prima di pubblicare l'app va spostata dietro una Cloud Function (vedi docs/ARCHITECTURE.md),
# perché qualunque variabile con prefisso VITE_ finisce nel bundle JS visibile a chiunque.
# Chiave gratuita: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
