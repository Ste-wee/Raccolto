# Copia questo file in .env e compila i valori reali. Non committare mai .env!

# Firebase (console.firebase.google.com > impostazioni progetto)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API key — SOLO lato server (Cloud Functions), MAI nel client
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
